{
  "version": 1,
  "sdk_version": "3.6.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hfhzkvuoywgxjklpiydq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "honorifico",
      "version": "0.1.0",
      "title": "Honorífico"
    },
    "tools": [
      {
        "name": "buscar_jurisprudencia",
        "title": "Buscar jurisprudência",
        "description": "Busca decisões judiciais no acervo do Honorífico por texto livre, com filtros opcionais de tribunal, UF e instância. Retorna ementa, órgão julgador e link da fonte.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "consulta": {
              "type": "string",
              "minLength": 2,
              "description": "Termos da busca, por exemplo: dano moral negativação indevida"
            },
            "tribunal": {
              "description": "Sigla do tribunal, por exemplo TJSP",
              "type": "string"
            },
            "uf": {
              "description": "UF de duas letras, por exemplo SP",
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            },
            "instancia": {
              "description": "Instância da decisão",
              "type": "string"
            },
            "limite": {
              "default": 10,
              "description": "Quantidade de resultados",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "consulta"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "ver_decisao",
        "title": "Ver decisão",
        "description": "Retorna os dados completos de uma decisão do acervo a partir do seu identificador, incluindo ementa, legislação citada e link da fonte.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador da decisão, obtido em buscar_jurisprudencia"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "buscar_sumulas",
        "title": "Buscar súmulas",
        "description": "Busca súmulas e enunciados no acervo do Honorífico por texto livre, com filtros opcionais de tribunal e área do direito.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "consulta": {
              "type": "string",
              "minLength": 2,
              "description": "Termos da busca, por exemplo: prescrição consumidor"
            },
            "tribunal": {
              "description": "Sigla do tribunal, por exemplo STJ",
              "type": "string"
            },
            "area": {
              "description": "Área do direito",
              "type": "string"
            },
            "limite": {
              "default": 10,
              "description": "Quantidade de resultados",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "consulta"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "meu_historico",
        "title": "Meu histórico",
        "description": "Lista os itens salvos na conta de quem está conectado: análises, petições e cálculos, do mais recente para o mais antigo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "tipo": {
              "default": "analises",
              "description": "Tipo de item do histórico",
              "type": "string",
              "enum": [
                "analises",
                "peticoes",
                "calculos"
              ]
            },
            "limite": {
              "default": 10,
              "description": "Quantidade de itens",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
